# Beeper Server artifacts baked into the image. Written ONLY by
# .github/workflows/beeper-server-feed.yaml (resolve-server.sh), which reads Beeper's update feed
# (https://api.beeper.com/desktop/update-feed.json?bundleID=com.automattic.beeper.server&...),
# downloads each artifact once, and records its sha256 -- the feed itself publishes no checksum.
# Review the PR it opens; a URL/sha change here is a server upgrade.
#
# UNRESOLVED: placeholders until the first feed workflow run. The image build refuses to run
# with these values.
BEEPER_SERVER_CHANNEL=stable
BEEPER_SERVER_VERSION=UNRESOLVED
BEEPER_SERVER_URL_amd64=UNRESOLVED
BEEPER_SERVER_SHA256_amd64=UNRESOLVED
BEEPER_SERVER_URL_arm64=UNRESOLVED
BEEPER_SERVER_SHA256_arm64=UNRESOLVED
